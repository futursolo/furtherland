{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@@post-components/*": [
        "./packages/post-components/src/*"
      ],
      "@@common/*": [
        "./packages/common/src/*"
      ],
      "@@frontend/*": [
        "./packages/frontend/src/*"
      ]
    }
  },
  "include": [
    "./src/**/*"
  ],
  "references": [
    {
      "path": "./packages/frontend"
    },
    {
      "path": "./packages/common"
    },
    {
      "path": "./packages/post-components"
    }
  ],
}
