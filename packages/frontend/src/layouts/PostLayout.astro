---
// Post layout: wraps BaseLayout and renders the post chrome via the PostPage
// React island, which owns the Main/Header/Author/Comments structure.
import PostPage from '@@frontend/components/PostPage';
import BaseLayout from '@@frontend/layouts/BaseLayout.astro';

interface Props {
  /** Document <title> value (passed to BaseLayout). */
  pageTitle: string;
  title: string;
  slug: string;
  date: string;
  isDraft: boolean;
}

const { pageTitle, title, slug, date, isDraft } = Astro.props;
---

<BaseLayout title={pageTitle}>
  <slot name="head" slot="head" />
  <PostPage client:load slug={slug} date={date} title={title} isDraft={isDraft}>
    <slot />
  </PostPage>
</BaseLayout>
