---
// Post layout: blog-post chrome rendered as Astro with React component islands.
// Uses Main/H1/Author/PostComments directly — no separate PostPage wrapper needed.

import { Main, MainContainer } from '@@frontend/components';
import Author from '@@frontend/components/Author';
import H1 from '@@frontend/components/H1';
import PostComments from '@@frontend/components/PostComments';
import BaseLayout from '@@frontend/layouts/BaseLayout.astro';

interface Props {
  /** Document <title> value (passed to BaseLayout). */
  pageTitle: string;
  title: string;
  slug: string;
  date: string;
  isDraft: boolean;
}

const { pageTitle, title, slug, date, isDraft } = Astro.props;
---

<BaseLayout title={pageTitle}>
  <slot name="head" slot="head" />
  <Main client:load>
    <MainContainer client:load>
      <H1 client:load>{title}</H1>
      <Author client:load date={date} isDraft={isDraft} />
      <article class="post-content">
        <slot />
      </article>
      <PostComments client:load slug={slug} />
    </MainContainer>
  </Main>
</BaseLayout>

<style>
.post-content {
  box-sizing: border-box;
  width: 100%;
}
</style>
