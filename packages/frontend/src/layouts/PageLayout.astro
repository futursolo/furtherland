---
// Page layout: static-page chrome rendered as Astro with React component islands.
// Uses Main/MainContainer/H1 directly — no separate Page wrapper needed.

import H1 from '@@frontend/components/H1.astro';
import Main from '@@frontend/components/Main.astro';
import MainContainer from '@@frontend/components/MainContainer.astro';
import BaseLayout from '@@frontend/layouts/BaseLayout.astro';

interface Props {
  /** Document <title> value (passed to BaseLayout). */
  pageTitle: string;
  /** Visible page heading rendered inside the layout. */
  title: string;
}

const { pageTitle, title } = Astro.props;
---

<BaseLayout title={pageTitle}>
  <slot name="head" slot="head" />
  <Main>
    <MainContainer>
      <H1>{title}</H1>
      <article class="page-content">
        <slot />
      </article>
    </MainContainer>
  </Main>
</BaseLayout>

<style>
.page-content {
  box-sizing: border-box;
  width: 100%;
}
</style>
