---
// Root layout: owns the site chrome (SyncTheme, Header, Footer) that wraps
// every page. Replaces the React RootLayout island so the shell can be
// server-rendered while individual interactive pieces hydrate separately.
import Box from '@@frontend/components/Box.astro';
import Footer from '@@frontend/components/Footer.astro';
import Header from '@@frontend/components/Header';
import SyncTheme from '@@frontend/components/SyncTheme';

interface Props {
  headerKind: 'home' | 'default';
}

const { headerKind } = Astro.props;
---

<SyncTheme client:load />
<Box class="root-layout">
  <Header client:load headerKind={headerKind} />
  <slot />
  <Footer />
</Box>

<style>
.root-layout {
  width: 100%;
  min-height: 100%;
  justify-content: space-around;
  align-items: center;
}
</style>
