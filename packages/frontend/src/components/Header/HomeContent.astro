---
// Pure-Astro counterpart of the (now-removed) React `HomeContent`. The home
// page's header content: the site title and a scroll hint. The hint is a small
// React island (`ScrollButton`) — the only interactive leaf of the server-
// rendered `Header` — which smooth-scrolls to `<main>` (the whole header is
// replaced on navigation, so a `document` lookup is enough for the target).
import { SITE_NAME } from '@@frontend/constants/site';

import ScrollButton from './ScrollButton';
---

<div class="layout">
  <div class="title">{SITE_NAME}</div>
  <div class="scroll-layout">
    <ScrollButton client:load />
  </div>
</div>

<style lang="scss">
  @use '@@frontend/styles/theme' as theme;

  .layout {
    width: 100%;

    flex-grow: 1;
    flex-basis: 1;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
  }

  .scroll-layout {
    height: 100px;
    font-size: 100px;

    @include theme.media-down(theme.$breakpoint-sm) {
      height: 60px;
      font-size: 60px;
    }
  }

  .title {
    font-size: 5rem;
    user-select: none;
    cursor: default;

    @include theme.media-down(theme.$breakpoint-lg) {
      font-size: 4rem;
    }

    @include theme.media-down(theme.$breakpoint-md) {
      font-size: 3rem;
    }

    @include theme.media-down(theme.$breakpoint-sm) {
      font-size: 2rem;
    }
  }
</style>
