---
// Pure-Astro counterpart of the (now-removed) React `HomeContent`. The home
// page's header content: the site title and a scroll hint. The hint's click
// handler is the only interactive piece — a small inline script, since the
// whole island is replaced on navigation (so a `document` lookup is enough for
// the scroll target).
import { SITE_NAME } from '@@frontend/constants/site';
---

<div class="layout">
  <div class="title">{SITE_NAME}</div>
  <div class="scroll-layout">
    <button class="scroll-button" type="button" aria-label="Scroll to main content">
      <svg
        aria-hidden="true"
        focusable="false"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
  </div>
</div>

<script>
const scrollToMain = () => {
  const navEl = document.querySelector('nav');
  if (!navEl) {
    return;
  }
  navEl.scrollIntoView({ behavior: 'smooth' });
};
for (const button of document.querySelectorAll('.scroll-button')) {
  button.addEventListener('click', scrollToMain);
}
</script>

<style lang="scss">
  @use '@@frontend/styles/theme' as theme;

  .layout {
    width: 100%;

    flex-grow: 1;
    flex-basis: 1;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
  }

  .scroll-layout {
    height: 100px;
    font-size: 100px;

    @include theme.media-down(theme.$breakpoint-sm) {
      height: 60px;
      font-size: 60px;
    }
  }

  .scroll-button {
    cursor: pointer;
    box-sizing: border-box;

    // Reset the native button chrome so the appearance matches the old icon-only
    // (unstyled `Box`) implementation.
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
    line-height: 0;
  }

  .title {
    font-size: 5rem;
    user-select: none;
    cursor: default;

    @include theme.media-down(theme.$breakpoint-lg) {
      font-size: 4rem;
    }

    @include theme.media-down(theme.$breakpoint-md) {
      font-size: 3rem;
    }

    @include theme.media-down(theme.$breakpoint-sm) {
      font-size: 2rem;
    }
  }
</style>
