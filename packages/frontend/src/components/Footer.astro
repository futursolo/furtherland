---
// Pure-Astro counterpart of the (now-removed) React `Footer` island. Renders the
// site footer (`<footer>`) with a responsive two-column layout (a title and a
// licensing note) that stacks vertically on small screens.
//
// Styles use the shared `theme` SCSS partial: the (runtime, theme-reactive)
// font colour is referenced through the `$font-colour-secondary-css-var` Sass
// variable (which resolves to the `--fl-theme-*` CSS custom property, so a
// typo is a build error and the value follows theme switching), and the
// responsive breakpoint via the `media-down` mixin — SCSS `@media` conditions
// cannot reference CSS custom properties and SFC `{{ }}` interpolation cannot
// reach inside a `<style>` block.
import { SITE_NAME } from '@@frontend/constants/site';
---

<footer class="footer">
  <div class="layout">
    <div class="title">&copy; 2026 {SITE_NAME}</div>
    <div class="copy">
      All articles on this site are licensed under the CC-BY-SA 4.0 International Licence.
    </div>
  </div>
</footer>

<style lang="scss">
  @use '@@frontend/styles/theme' as theme;

  .footer {
    height: 100px;
    width: 100%;

    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;

    box-sizing: border-box;

    padding-left: max(20px, env(safe-area-inset-left));
    padding-right: max(20px, env(safe-area-inset-right));
  }

  .layout {
    max-width: calc(#{theme.$bp-md} - 40px);
    width: #{theme.$bp-md};

    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    @include theme.media-down(theme.$bp-md) {
      flex-direction: column;
    }
  }

  .copy {
    color: theme.$font-colour-secondary-css-var;
    transition: color 0.2s;
  }
</style>
