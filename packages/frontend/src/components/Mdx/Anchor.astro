---
import type { HTMLAttributes } from 'astro/types';

// Pure-Astro counterpart of the (now-removed) React `Anchor` island. Renders an
// inline link (`<a>`) used for the `[text](url)` form in MDX.
type Props = HTMLAttributes<'a'>;

import { theme } from '@@frontend/providers/theme';
---

<!-- biome-ignore lint/a11y/useValidAnchor: the `href` is supplied by MDX via props -->
<!-- biome-ignore lint/a11y/useAnchorContent: the link content is supplied by MDX via the slot -->
<a {...Astro.props}>
  <slot />
</a>

<style define:vars={{ colour: theme.fontColour.primary.cssVar }}>
a {
  color: var(--colour);
  font-weight: bold;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}
</style>
