---
import type { HTMLAttributes } from 'astro/types';

// Pure-Astro override for the `table` element in MDX. Renders a table wrapped
// in a horizontally scrollable container so wide tables do not overflow the
// page on small screens. The `thead`/`tbody`/`tr`/`th`/`td` are supplied by
// MDX via the slot and carry the MDX scope hash (not this component's), so the
// descendant selectors below target them through `:global(...)`, anchored on
// the hashed `.fl-mdx-table` wrapper. The base (light) rules use fixed light
// colours; the dark-theme palette is scoped to `html[data-theme='dark']`
// (also through `:global(...)`).
type Props = HTMLAttributes<'table'>;
---

<div class="fl-mdx-table">
  <table {...Astro.props}>
    <slot />
  </table>
</div>

<style lang="scss">
  @use '@@frontend/styles/theme' as theme;

  .fl-mdx-table {
    width: 100%;
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid rgb(206, 211, 219);
    border-radius: 4px;
    background-color: theme.$background-colour-component-css-var;
  }

  .fl-mdx-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    color: theme.$font-colour-primary-css-var;
  }

  .fl-mdx-table :global(th) {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: theme.$font-colour-primary-css-var;
  }

  .fl-mdx-table :global(td) {
    padding: 0.6rem 1rem;
    line-height: 1.6;
    color: theme.$font-colour-primary-css-var;
  }

  :global(html[data-theme='light']) .fl-mdx-table {
    background-color: rgb(255, 255, 255);
  }

  // Light-only header tint; overridden for the dark theme below.
  :global(html[data-theme='light']) .fl-mdx-table :global(thead) {
    background-color: rgb(242, 245, 255);
  }

  // Light-only divider colour, matched by the table outline above.
  :global(html[data-theme='light']) .fl-mdx-table :global(th) {
    border-bottom: 2px solid rgb(206, 211, 219);
  }

  :global(html[data-theme='light']) .fl-mdx-table :global(td) {
    border-bottom: 1px solid rgb(206, 211, 219);
  }

  // Dark-theme palette: a dark body with a lighter header band.
  :global(html[data-theme='dark']) .fl-mdx-table {
    border-color: rgb(57, 63, 78);
    background-color: rgb(51, 53, 62);
  }

  :global(html[data-theme='dark']) .fl-mdx-table :global(thead) {
    background-color: rgb(57, 63, 78);
  }

  :global(html[data-theme='dark']) .fl-mdx-table :global(th) {
    border-bottom: 2px solid rgb(57, 63, 78);
  }

  :global(html[data-theme='dark']) .fl-mdx-table :global(td) {
    border-bottom: 1px solid rgb(57, 63, 78);
  }
</style>
