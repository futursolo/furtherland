---
import type { HTMLAttributes } from 'astro/types';

// Pure-Astro counterpart of the (now-removed) React `H2` island. Renders a
// section `<h2>` heading: a full-width flex column, left-aligned, at a `2rem`
// font size. Props are typed as the built-in attributes for an `<h2>` (Astro
// TypeScript guide, "Built-in HTML attributes"), so consumers can pass
// `class`, `class:list`, `style` or any other valid `<h2>` attribute. A passed
// `class`/`class:list` is merged with the base `h2` class via the `class:list`
// directive (deduplicated through clsx); all remaining attributes are forwarded
// to the element. A `<slot/>` holds the children.
type Props = HTMLAttributes<'h2'>;

const { class: className, 'class:list': classList, ...restProps } = Astro.props;
---

<!-- biome-ignore lint/a11y/useHeadingContent: the heading content is supplied by the consumer via the slot -->
<h2 class:list={['h2', className, classList]} {...restProps}>
  <slot />
</h2>

<style>
.h2 {
  display: flex;
  width: 100%;

  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;

  font-size: 2rem;
}
</style>
