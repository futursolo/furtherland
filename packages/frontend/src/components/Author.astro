---
// Pure-Astro counterpart of the (now-removed) React `Author` island. Renders a
// post's byline: the site author's avatar beside their name and the post's
// (optionally draft) date.
//
// Font colours reference the shared `theme` SCSS partial's CSS variables
// (`$font-colour-*-css-var` → `--fl-theme-*`), so a typo is a build error and
// the value follows theme switching; font sizes mirror `theme.fontSize`
// (they are not theme-reactive, so they are declared as literal values here).
import { AUTHOR_NAME } from '@@frontend/constants/site';

interface Props {
  date: string;
  isDraft: boolean;
}

const { date, isDraft } = Astro.props;
---

<div class="author">
  <div class="author-image"></div>
  <div class="author-right">
    <div class="author-name">{AUTHOR_NAME}</div>
    <div class="authored-date">
      {date}{isDraft ? ' (Draft)' : ''}
    </div>
  </div>
</div>

<style lang="scss">
  @use '@@frontend/styles/theme' as theme;

  .author {
    display: flex;
    width: 100%;
    padding-bottom: 10px;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
  }

  .author-image {
    background-image: url('https://www.gravatar.com/avatar/0dd494a963ae648caebe34288b664ca6?s=200');
    height: 50px;
    width: 50px;
    border-radius: 50px;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .author-right {
    display: flex;
    height: 50px;
    padding-bottom: 10px;

    flex-direction: column;
    align-items: flex-start;
    justify-content: space-around;
    padding-left: 10px;
    padding-right: 10px;
  }

  .author-name {
    font-size: 1rem;
    color: theme.$font-colour-primary-css-var;
  }

  .authored-date {
    font-size: 0.9rem;
    color: theme.$font-colour-secondary-css-var;
  }
</style>
