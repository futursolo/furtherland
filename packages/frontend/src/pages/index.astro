---
import { H2, Link } from '@@frontend/components';
import Author from '@@frontend/components/Author.astro';
import Main from '@@frontend/components/Main.astro';
import MainContainer from '@@frontend/components/MainContainer.astro';
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '@@frontend/constants/site';
import BaseLayout from '@@frontend/layouts/BaseLayout.astro';
import formatTitle from '@@frontend/utils/formatTitle';

import { type CollectionEntry, getCollection } from 'astro:content';

const summaries: CollectionEntry<'posts'>[] = [];

for (const entry of await getCollection(
  'posts',
  (post) => !post.data.isDraft || !import.meta.env.PROD,
)) {
  summaries.push(entry);
}

summaries.sort((l, r) => {
  if (new Date(l.data.date) === new Date(r.data.date)) {
    return 0;
  }

  return new Date(l.data.date) > new Date(r.data.date) ? -1 : 1;
});

const title = formatTitle('Home');
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <meta name="description" content={SITE_DESCRIPTION}>
    <link rel="canonical" href={`${SITE_URL}/`}>
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={SITE_DESCRIPTION}>
    <meta property="og:url" content={`${SITE_URL}/`}>
    <meta property="og:site_name" content={SITE_NAME}>
  </Fragment>
  <Main class="home-main">
    <MainContainer>
      <div class="post-list">
        {summaries.map((entry) => {
            const { date, slug, title: postTitle, isDraft } = entry.data;
            return (
              <div class="post">
                <Link client:load href={`/posts/${slug}`}>
                  <H2 client:load>{postTitle}</H2>
                </Link>
                <Author date={date} isDraft={isDraft} />
              </div>
            );
          })}
      </div>
    </MainContainer>
  </Main>
</BaseLayout>

<style>
.home-main {
  min-height: calc(100vh - 160px);
}

.post-list {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
}

.post {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
}
</style>
