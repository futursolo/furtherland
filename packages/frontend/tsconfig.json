{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "composite": true,
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "paths": {
      "@@frontend/*": [
        "./src/*"
      ],
      "@@common/*": [
        "../common/src/*"
      ],
      "@@post-components/*": [
        "../post-componments/src/*"
      ]
    }
  },
  "include": [
    "../common/src/**/*",
    "../post-components/src/**/*",
    "./src/**/*",
    "./astro.config.ts",
    ".astro/types.d.ts"
  ],
  "references": [
    {
      "path": "../post-components"
    }
  ]
}
